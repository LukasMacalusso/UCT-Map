# =============================================================================
# UCT Map - Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# Copia este archivo como .env y edita los valores correspondientes:
#   cp .env.example .env
# =============================================================================

APP_ENV=development

# -----------------------------------------------------------------------------
# URL Base del API Gateway
# -----------------------------------------------------------------------------
# - En navegador Web o escritorio Linux: http://localhost:5000
# - En emulador oficial de Android:      http://10.0.2.2:5000
# - En dispositivo físico / Wi-Fi local: http://<IP_DE_TU_PC>:5000
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:5000

# Tiempo límite para peticiones HTTP en segundos
API_TIMEOUT_SECONDS=15

# Credenciales de API (opcional)
API_KEY=
API_SECRET=

# -----------------------------------------------------------------------------
# URLs directas de microservicios (Opcional)
# -----------------------------------------------------------------------------
IDENTITY_SERVICE_URL=
CAMPUS_SERVICE_URL=
SCHEDULE_SERVICE_URL=
INCIDENT_SERVICE_URL=

# -----------------------------------------------------------------------------
# Servicios de Mapas y Cartografía
# -----------------------------------------------------------------------------
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

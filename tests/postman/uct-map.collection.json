            ],
            "url": {
              "raw": "{{baseUrl}}/api/schedule/students/{{schedule_student_id}}/meetings?from={{schedule_from}}&to={{schedule_to}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "schedule", "students", "{{schedule_student_id}}", "meetings"],
              "query": [
                {
                  "key": "from",
                  "value": "{{schedule_from}}"
                },
                {
                  "key": "to",
                  "value": "{{schedule_to}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Schedule responds via Gateway with 200 or 400 validation\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});"
                ]
              }
            }
          ]
        },

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtConfig": {
    "Issuer": "https://identity-api",
    "Audience": "api-gateway",
    "Key": "7d82f3a9b4e1c60d5f27a8b9c0d1e2f3a4b5c6d7e8f90a1b2c3d4e5f6a7b8c9d",
    "TokenValidationMins": 30
  },

  "ReverseProxy": {
    "Routes": {
      "CampusRoute": {
        "ClusterId": "CampusCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/campus/{**catch-all}"
        }
      },
      "IdentityRoute": {
        "ClusterId": "IdentityCluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "IncidentRoute": {
        "ClusterId": "IncidentCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/incident/{**catch-all}"
        }
      },
      "ScheduleRoute": {
        "ClusterId": "ScheduleCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/schedule/{**catch-all}"
        }
      }
    },


    "Clusters": {
      "CampusCluster": {
        "Destinations": {
          "campus-node-1": {
            "Address": "http://campus-api:8080"
          }
        }
      },
      "IdentityCluster": {
        "Destinations": {
          "identity-node-1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "IncidentCluster": {
        "Destinations": {
          "incident-node-1": {
            "Address": "http://incident-api:8080"
          }
        }
      },
      "ScheduleCluster": {
        "Destinations": {
          "schedule-node-1": {
            "Address": "http://schedule-api:8080"
          }
        }
      }
    }
  }
}

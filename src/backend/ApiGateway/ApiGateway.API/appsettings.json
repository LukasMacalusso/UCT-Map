{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtConfig": {
    "Issuer": "https://identity-api",
    "Audience": "api-gateway",
    "TokenValidationMins": 30
  },

  "ReverseProxy": {
    "Routes": {
      "CampusPublicReadRoute": {
        "ClusterId": "CampusCluster",
        "Match": {
          "Path": "/api/campus/{**catch-all}",
          "Methods": [ "GET", "HEAD" ]
        }
      },
      "CampusProtectedWriteRoute": {
        "ClusterId": "CampusCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/campus/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "IdentityRoute": {
        "ClusterId": "IdentityCluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "IncidentRoute": {
        "ClusterId": "IncidentCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/incident/{**catch-all}"
        }
      },
      "ScheduleRoute": {
        "ClusterId": "ScheduleCluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/schedule/{**catch-all}"
        }
      }
    },


    "Clusters": {
      "CampusCluster": {
        "Destinations": {
          "campus-node-1": {
            "Address": "http://campus-api:8080"
          }
        }
      },
      "IdentityCluster": {
        "Destinations": {
          "identity-node-1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "IncidentCluster": {
        "Destinations": {
          "incident-node-1": {
            "Address": "http://incident-api:8080"
          }
        }
      },
      "ScheduleCluster": {
        "Destinations": {
          "schedule-node-1": {
            "Address": "http://schedule-api:8080"
          }
        }
      }
    }
  }
}

# =============================================================================
# UCT-Map — Environment Variables Template
# =============================================================================
# Copy this file to `.env` before running `docker compose up` or `make up`:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit `.env` to version control (it is excluded via `.gitignore`).
# - `docker-compose.yml` enforces fail-fast validation (`:?`) on all required
#   secrets so containers will refuse to start with missing credentials.
# - In Production (Kubero), inject the corresponding service variables
#   (`ConnectionStrings__*`, `MongoDB__*`, `JwtConfig__*`) directly via
#   Kubero's Environment Variables / Secrets panel.
# =============================================================================

# --- Runtime Environment ---
# Values: Production | Staging | Development
# Note: `make up` runs hardened in Production; `make up-dev` (docker-compose.dev.yml)
# automatically overrides this to Development to enable Swagger UI.
ASPNETCORE_ENVIRONMENT=Production

# --- PostgreSQL Credentials (Identity, Campus, Schedule) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- Identity Initial Administrator ---
# Used only when the database has no active administrator (first deploy).
# Once an admin exists, these values are ignored and never overwrite an account.
# Change the password after the first login in Production.
IDENTITY_ADMIN_EMAIL=admin@uct.cl
IDENTITY_ADMIN_PASSWORD=CHANGE_ME_Strong_Admin_Password1!

# --- MongoDB Credentials (Incident) ---
MONGO_USER=root
MONGO_PASSWORD=CHANGE_ME_STRONG_MONGO_PASSWORD

# --- JWT Authentication Configuration (Shared by Identity, Gateway, Campus, Schedule) ---
# Must be at least 32 characters (256 bits) for HMAC-SHA256 signing.
# Generate a secure random key with:
#   openssl rand -hex 32
UCT_JWT_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_RANDOM_HEX_SECRET_KEY
UCT_JWT_ISSUER=https://identity-api
UCT_JWT_AUDIENCE=api-gateway
UCT_JWT_EXPIRATION_MINS=30
